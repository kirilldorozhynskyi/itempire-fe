{
	"title": "Vite front-end twig boilerplate",
	"name": "starter_frontend_twig",
	"version": "3.3.0",
	"type": "module",
	"private": true,
	"keywords": [
		"boilerplate",
		"startkit",
		"template",
		"library",
		"front end",
		"css",
		"documentation",
		"sass",
		"twig",
		"vite",
		"vituum",
		"sassdoc",
		"grid",
		"layout",
		"framework",
		"frameworks"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"webp": "node scripts/webp.js",
		"i18n:add": "vue-i18n-extract report --vueFiles './src/scripts/**/**/**/*.?(js|vue)' --languageFiles './src/scripts/util/lang/*.?(json|yml|yaml|js|ts)' --add",
		"i18n:remove": "vue-i18n-extract remove --vueFiles './src/scripts/**/*.?(js|vue)' --languageFiles './src/scripts/util/lang/*.?(json|yml|yaml|js|ts)' --remove"
	},
	"devDependencies": {
		"@spiriit/vite-plugin-svg-spritemap": "^7.2.0",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vituum/vite-plugin-twig": "^2.0.1",
		"@vue/runtime-core": "^3.5.43",
		"@zackad/prettier-plugin-twig": "^0.17.0",
		"html-minifier-terser": "^7.2.0",
		"prettier": "^3.9.8",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.34.5",
		"svgo": "^4.1.0",
		"typescript": "^7.0.2",
		"vanilla-lazyload": "^19.1.3",
		"vite": "^8.3.0",
		"vite-plugin-beautify": "^1.0.0",
		"vite-plugin-favicons-inject": "^2.2.0",
		"vite-plugin-image-optimizer": "^2.0.3",
		"vituum": "^2.0.2",
		"vue": "^3.5.43",
		"vue-i18n": "^11.4.12",
		"vue-i18n-extract": "^2.0.7"
	},
	"dependencies": {
		"@primeuix/themes": "^3.0.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"embla-carousel-fade": "^8.6.0",
		"embla-carousel-vue": "^8.6.0",
		"photoswipe": "^5.4.4",
		"primevue": "^5.0.1",
		"tailwindcss": "^4.3.3",
		"vue3-google-map": "^0.27.2"
	}
}
