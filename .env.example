# Microsoft Graph application credentials
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mailbox used by Microsoft Graph and optional destination override
MICROSOFT_SENDER_EMAIL=info@itempire.sk
CONTACT_RECIPIENT_EMAIL=info@itempire.sk

# Existing project variable names are also supported:
# MICROSOFT_GRAPH_TENANT_ID=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MAIL_FROM_ADDRESS=info@itempire.sk
# MAIL_USERNAME=info@itempire.sk
