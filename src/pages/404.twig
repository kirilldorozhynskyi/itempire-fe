{% extends 'views/layouts/main.twig' %}

{% set title = 'Stránka sa nenašla' %}
{% set description = 'Stránka, ktorú hľadáte, sa presunula alebo už nie je dostupná.' %}
{% set robots = 'noindex, follow' %}
{% set url = '/404/' %}

{% block page %}
	<section class="py-20 md:py-24">
		<div class="container flex justify-center">
			<div class="flex max-w-160 flex-col items-center gap-6 text-center">
				<span class="tag">404</span>

				<div class="flex flex-col items-center gap-6">
					<h1 class="text-balance font-serif text-4xl font-semibold leading-tight lg:text-6xl">
						<span class="text-primary-500/70">Stránka sa stratila.</span><br />
						Vaše dáta nie.
					</h1>

					<p class="max-w-120 text-balance text-primary-500/70">
						Stránka, ktorú hľadáte, sa presunula alebo už nie je dostupná.<br class="hidden sm:block" />
						Ak potrebujete pomoc, sme tu.
					</p>
				</div>

				<div>
					{% include 'views/components/utils/_button.twig' with {
						button: {
							class: 'btn-purple',
							btn: {
								title: 'Späť na úvod',
								url: '/'
							}
						}
					} only %}
				</div>
			</div>
		</div>
	</section>
{% endblock %}
