<!DOCTYPE html>
<html lang="{{ lang }}">
	<head>
		<meta charset="utf-8" />

		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />

		<meta name="viewport" content="width=device-width,initial-scale=1, shrink-to-fit=no" />

		<title>
			{{ title }} | {{ site_title }}
		</title>
		<meta name="description" content="{{ description }}" />

		<meta property="og:description" content="{{ description }}" />
		<meta property="og:title" content="{{ title }} | {{ site_title }}" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="{{ siteURL }}{{ page.url }}" />
		<meta property="og:image" content="/assets/system/facebook-og-image.jpg" />
		<meta name="twitter:description" content="{{ description }}" />
		<meta name="twitter:title" content="{{ title }} | {{ site_title }}" />
		<meta name="twitter:image:src" content="/assets/system/twitter-og-image.jpg" />
		<meta name="twitter:card" content="summary_large_image" />

		<script
			type="module"
			src="https://cdn.snootl.com/scripts/widget/snootl-widget.esm.js"
			data-api-key="kmB8gwEZu6"
			data-snootl-load="interaction"
			fetchpriority="low"
		></script>
	</head>
	<body class="{{ body_class }}">
		<div id="app" class="flex flex-col min-h-screen">
			{# Header #}
			{% if not hide_header %}
				{% include '../components/page/header/_header.twig' %}
			{% elseif mobile_header %}
				<div class="lg:hidden">
					{% include '../components/page/header/_header.twig' %}
				</div>
			{% endif %}

			{# Content #}
			<main class="wrapper-content">
				{% block page %}

				{% endblock %}
			</main>

			{# Footer #}
			{% if not hide_footer %}
				{% include '../components/page/footer/_footer.twig' %}
			{% endif %}
		</div>

		<script type="module" src="/src/scripts/app.ts"></script>
	</body>
</html>
