<section class="py-20 md:py-24 lg:py-36">
	<div class="container flex flex-col gap-12 md:gap-16 lg:gap-20">
		{% include '../title/_title.twig' with {
			ce: ce
		} %}

		<div class="grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-4">
			{% for item in ce.numbers %}
				<div
					v-jd-animate="{ delay: {{ loop.index * 100 }} }"
					class="bg-remover relative flex flex-col gap-6 bg-neutral-100 p-4 md:min-h-48 md:p-6 lg:gap-16"
				>
					<h3 class="text-balance font-serif leading-tight font-semibold text-2xl lg:text-5xl">{{ item.number }}</h3>

					<p class="text-sm lg:text-lg text-subtile">
						{{ item.title }}
					</p>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
