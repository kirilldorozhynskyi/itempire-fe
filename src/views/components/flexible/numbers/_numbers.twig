<section class="py-20 lg:py-36">
	<div class="container flex flex-col gap-20">
		{% include '../title/_title.twig' with {
			ce: ce
		} %}

		<div class="grid grid-cols-2 gap-4 lg:gap-6 lg:grid-cols-4">
			{% for item in ce.numbers %}
				<div v-jd-animate="{ delay: {{ loop.index * 100 }} }" class="flex flex-col gap-6 lg:gap-16 p-4 lg:p-6 bg-neutral-100 relative bg-remover">
					<h3 class="text-balance font-serif leading-tight font-semibold text-2xl lg:text-5xl">{{ item.number }}</h3>

					<p class="text-sm lg:text-lg text-subtile leading-normal">
						{{ item.title }}
					</p>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
