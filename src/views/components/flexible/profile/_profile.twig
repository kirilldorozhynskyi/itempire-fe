{#
 # File: /src/views/components/flexible/profile/_profile.twig
 # Project: itempire-fe
 #}

<profile-actions>
	<template #default="{ openAddress, confirmDelete }">
		<tabs value="0">
			<div class="container">
				<div class="overflow-x-auto">
					<tab-list class="min-w-150">
						<tab value="0">
							Fakturačné údaje
						</tab>
						<tab value="1">
							Doručovacie adresy
						</tab>
						<tab value="2">
							Objednávky
						</tab>
					</tab-list>
				</div>
			</div>

			<tab-panels>
				<tab-panel value="0">
					<section class="bg-neutral-100 py-12 lg:py-16">
						<div class="container flex flex-col gap-10">
							<h1 class="font-serif text-4xl font-semibold leading-tight">Fakturačné údaje</h1>

							<form class="flex flex-col gap-8 bg-white p-6 lg:p-12">
								<div class="flex items-center gap-6">
									<div class="flex size-16 items-center justify-center bg-neutral-100 text-3xl text-white">
										{{ sprite('user-avatar') }}
									</div>
									<div>
										<div class="font-serif text-lg font-semibold">
											{{ ce.user.name }}
										</div>
										<div>
											{{ ce.user.email }}
										</div>
									</div>
								</div>

								<label class="form-check">
									<input class="form-check-input" type="checkbox" name="companyAccount" checked />
									<span>Firemný účet</span>
								</label>

								<div class="flex flex-col gap-4">
									<h2 class="font-serif text-2xl font-semibold">Základné informácie</h2>
									<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
										<label class="profile-field"><span>Meno*</span><input name="firstName" value="Martin" /></label>
										<label class="profile-field"><span>Priezvisko*</span><input name="lastName" value="Chynoranský" /></label>
										<label class="profile-field"><span>Názov firmy</span><input name="company" value="NovaTech Logistika, s.r.o." /></label>
										<label class="profile-field"><span>IČ DPH</span><input name="vatId" value="SK2121834507" /></label>
										<label class="profile-field"><span>IČO</span><input name="companyId" value="54 821 073" /></label>
										<label class="profile-field"><span>DIČ</span><input name="taxId" value="2121 834 507" /></label>
										<label class="profile-field md:col-span-2">
											<span>Ulica a číslo *</span><input name="street" value="Priemyselná 14" />
										</label>
									</div>
									<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-4">
										<label class="profile-field"><span>Mesto *</span><input name="city" value="Nitra" /></label>
										<label class="profile-field"><span>PSČ*</span><input name="zip" value="949 01" /></label>
									</div>
									<label class="profile-field">
										<span>Krajina</span>
										<select name="country">
											<option>
												Slovensko
											</option>
										</select>
									</label>
								</div>

								<div class="flex flex-col gap-4">
									<h2 class="font-serif text-2xl font-semibold">Kontaktné údaje</h2>
									<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
										<label class="profile-field"><span>E-mail</span><input name="email" type="email" value="{{ ce.user.email }}" /></label>
										<label class="profile-field"><span>Tel. číslo</span><input name="phone" type="tel" value="+421 37 640 2200" /></label>
									</div>
								</div>

								<div>
									<button type="submit" class="btn-purple">Uložiť zmeny</button>
								</div>
							</form>
						</div>
					</section>
				</tab-panel>

				<tab-panel value="1">
					<section class="bg-neutral-100 py-12 lg:py-16">
						<div class="container flex flex-col gap-10">
							<h1 class="font-serif text-4xl font-semibold leading-tight">Doručovacie adresy</h1>

							<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
								{% for address in ce.addresses %}
									<article class="flex flex-col gap-6 bg-white p-6">
										<div class="flex items-center gap-4">
											<div class="flex size-12 items-center justify-center bg-neutral-100 text-2xl text-white">
												{{ sprite('user-avatar') }}
											</div>
											<h2 class="font-serif text-lg font-semibold">{{ address.name }}</h2>
										</div>

										<address class="not-italic leading-relaxed">
											{{ address.street }}<br />
											{{ address.city }}<br />
											{{ address.country }}<br />
											{{ address.phone }}<br />
											{{ address.email }}
										</address>

										<div class="mt-auto grid grid-cols-2 gap-2">
											<button type="button" class="btn-outline-neutral px-3" @click="openAddress('edit')">
												{{ sprite('pencil') }} Upraviť
											</button>
											<button type="button" class="btn-outline-neutral px-3" @click="confirmDelete">
												{{ sprite('trash') }} Odstrániť
											</button>
										</div>
									</article>
								{% endfor %}
							</div>

							<div>
								<button type="button" class="btn-purple" @click="openAddress('add')">{{ sprite('plus') }} Pridať novú adresu</button>
							</div>
						</div>
					</section>
				</tab-panel>

				<tab-panel value="2">
					<section class="bg-neutral-100 py-12 lg:py-16">
						<div class="container flex flex-col gap-10">
							<h1 class="font-serif text-4xl font-semibold leading-tight">Objednávky</h1>

							<div class="bg-white p-4 lg:p-12">
								<div class="hidden grid-cols-[1fr_2.5fr_1fr_1fr_auto] gap-6 px-2 pb-4 font-medium lg:grid">
									<div>
										Dátum
									</div>
									<div>
										Číslo objednávky
									</div>
									<div>
										Suma
									</div>
									<div>
										Stav
									</div>
									<div>
										Faktúra
									</div>
								</div>

								<div>
									{% for order in ce.orders %}
										<details class="group {{ loop.index is odd ? 'bg-neutral-100' : '' }}" {{ order.open ? 'open' }}>
											<summary
												class="grid cursor-pointer list-none grid-cols-2 gap-3 px-2 py-3 [&::-webkit-details-marker]:hidden lg:grid-cols-[1fr_2.5fr_1fr_1fr_auto] lg:gap-6"
											>
												<div>
													<span class="text-subtile lg:hidden">Dátum:&nbsp;</span>{{ order.date }}
												</div>
												<div>
													<span class="text-subtile lg:hidden">Objednávka:&nbsp;</span>{{ order.number }}
												</div>
												<div class="font-medium text-purple">
													{{ order.total }}
												</div>
												<div>
													{{ order.status }}
												</div>
												<a href="/" class="btn-outline-neutral col-span-2 px-2 py-1 lg:col-span-1" @click.stop>
													{{ sprite('file-description') }} Faktúra {{ order.number }}
												</a>
												<div class="col-span-2 flex items-center gap-3 text-sm font-medium lg:col-span-5">
													Zobraziť položky
													{{ sprite('chevron-down', 'transit group-open:rotate-180') }}
												</div>
											</summary>

											{% if order.items %}
												<div class="flex flex-col gap-3 px-2 pb-5">
													{% for product in order.items %}
														<div class="grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-3">
															<img src="/assets/images/products/product.png" alt="" class="size-10 object-contain" />
															<span>{{ product.title }}</span>
															<span class="whitespace-nowrap">{{ product.quantity }}ks&nbsp;&nbsp; {{ product.price }}</span>
														</div>
													{% endfor %}
												</div>
											{% endif %}
										</details>
									{% endfor %}
								</div>

								<div class="flex justify-center pt-10">
									<button type="button" class="btn-outline-neutral">Načítať viac ({{ ce.moreCount }})</button>
								</div>
							</div>
						</div>
					</section>
				</tab-panel>
			</tab-panels>
		</tabs>
	</template>

	<template #address-header="{ editing }">
		<h2 v-if="editing" class="font-serif text-2xl font-semibold leading-tight">Upraviť adresu</h2>
		<h2 v-else class="font-serif text-2xl font-semibold leading-tight">Nová doručovacia adresa</h2>
	</template>

	<template #address="{ close, editing }">
		<form class="flex flex-col gap-4" @submit.prevent="close">
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<label class="profile-field">
					<span>Meno*</span>
					<input name="firstName" type="text" :value="editing ? 'Martin' : ''" placeholder="Martin" required />
				</label>
				<label class="profile-field">
					<span>Priezvisko*</span>
					<input name="lastName" type="text" :value="editing ? 'Chynoranský' : ''" placeholder="Chynoranský" required />
				</label>
				<label class="profile-field">
					<span>E-mail</span>
					<input name="email" type="email" :value="editing ? 'chynoransky@gmail.com' : ''" placeholder="Zadajte váš e-mail" />
				</label>
				<label class="profile-field">
					<span>Tel. č.</span>
					<input name="phone" type="tel" :value="editing ? '+421 37 640 2200' : ''" placeholder="+421 900 000 000" />
				</label>
			</div>

			<label class="profile-field">
				<span>Názov firmy</span>
				<input name="company" type="text" :value="editing ? 'NovaTech Logistika, s.r.o.' : ''" placeholder="NovaTech Logistika, s.r.o." />
			</label>
			<label class="profile-field">
				<span>Ulica a číslo *</span>
				<input name="street" type="text" :value="editing ? 'Priemyselná 14' : ''" placeholder="Zadajte ulicu" required />
			</label>

			<div class="grid grid-cols-[minmax(0,1fr)_7.75rem] gap-4">
				<label class="profile-field">
					<span>Mesto *</span>
					<input name="city" type="text" :value="editing ? 'Nitra' : ''" placeholder="Názov mesta" required />
				</label>
				<label class="profile-field">
					<span>PSČ*</span>
					<input name="zip" type="text" :value="editing ? '949 01' : ''" placeholder="000 00" required />
				</label>
			</div>

			<label class="profile-field">
				<span>Krajina</span>
				<select name="country">
					<option>
						Slovensko
					</option>
				</select>
			</label>

			<button type="submit" class="btn-purple w-full justify-center">Uložiť</button>
			<button v-if="editing" type="button" class="btn-outline-neutral w-full justify-center" @click="close">Vrátiť späť</button>
		</form>
	</template>

	<template #delete-header>
		<h2 class="font-serif text-2xl font-semibold leading-tight">Naozaj chcete odstrániť adresu?</h2>
	</template>

	<template #delete="{ close }">
		<div class="flex flex-col gap-8">
			<p>
				Táto akcia je nevratná
			</p>
			<div class="flex flex-col gap-3">
				<button type="button" class="btn-red w-full justify-center" @click="close">Odstrániť adresu</button>
				<button type="button" class="btn-outline-neutral w-full justify-center" @click="close">Vrátiť späť</button>
			</div>
		</div>
	</template>
</profile-actions>
