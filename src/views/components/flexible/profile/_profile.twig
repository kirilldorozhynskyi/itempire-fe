{#
 # File: /src/views/components/flexible/profile/_profile.twig
 # Project: itempire-fe
 #}

<profile-actions>
	<template #default="{ openAddress, confirmDelete }">
		<tabs value="0">
			<div class="container">
				<div class="overflow-x-auto">
					<tab-list class="min-w-150">
						<tab value="0">
							Fakturačné údaje
						</tab>
						<tab value="1">
							Doručovacie adresy
						</tab>
						<tab value="2">
							Objednávky
						</tab>
					</tab-list>
				</div>
			</div>

			<tab-panels>
				<tab-panel value="0">
					<section class="bg-neutral-100 py-12 lg:py-16">
						<div class="container flex flex-col gap-10">
							<h1 class="font-serif text-2xl font-semibold leading-tight lg:text-4xl">Fakturačné údaje</h1>

							<form class="flex flex-col gap-8 bg-white p-6 lg:p-12">
								<div class="flex items-center gap-6">
									<div class="flex size-16 items-center justify-center bg-neutral-100 text-3xl text-white">
										{{ sprite('user-avatar') }}
									</div>
									<div>
										<div class="font-serif text-lg font-semibold">
											{{ ce.user.name }}
										</div>
										<div>
											{{ ce.user.email }}
										</div>
									</div>
								</div>

								<label class="form-check">
									<input class="form-check-input" type="checkbox" name="companyAccount" checked />
									<span>Firemný účet</span>
								</label>

								<div class="flex flex-col gap-4">
									<h2 class="font-serif text-2xl font-semibold">Základné informácie</h2>
									<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
										<float-field
											id="profile-first-name"
											label="Meno*"
											name="firstName"
											model-value="Martin"
											autocomplete="given-name"
											required
										></float-field>
										<float-field
											id="profile-last-name"
											label="Priezvisko*"
											name="lastName"
											model-value="Chynoranský"
											autocomplete="family-name"
											required
										></float-field>
										<float-field
											id="profile-company"
											label="Názov firmy"
											name="company"
											model-value="NovaTech Logistika, s.r.o."
											autocomplete="organization"
										></float-field>
										<float-field id="profile-vat-id" label="IČ DPH" name="vatId" model-value="SK2121834507"></float-field>
										<float-field id="profile-company-id" label="IČO" name="companyId" model-value="54 821 073"></float-field>
										<float-field id="profile-tax-id" label="DIČ" name="taxId" model-value="2121 834 507"></float-field>
										<float-field
											id="profile-street"
											label="Ulica a číslo *"
											name="street"
											model-value="Priemyselná 14"
											autocomplete="street-address"
											class="md:col-span-2"
											required
										></float-field>
									</div>
									<div class="grid grid-cols-1 gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
										<float-field
											id="profile-city"
											label="Mesto *"
											name="city"
											model-value="Nitra"
											autocomplete="address-level2"
											required
										></float-field>
										<float-field
											id="profile-zip"
											label="PSČ*"
											name="zip"
											model-value="949 01"
											autocomplete="postal-code"
											required
										></float-field>
									</div>
									<float-field id="profile-country" label="Krajina" name="country" field-type="select" model-value="SK">
										<option value="SK">
											Slovensko
										</option>
									</float-field>
								</div>

								<div class="flex flex-col gap-4">
									<h2 class="font-serif text-2xl font-semibold">Kontaktné údaje</h2>
									<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
										<float-field
											id="profile-email"
											label="E-mail"
											name="email"
											field-type="email"
											model-value="{{ ce.user.email }}"
											autocomplete="email"
										></float-field>
										<float-field
											id="profile-phone"
											label="Tel. číslo"
											name="phone"
											field-type="tel"
											model-value="+421 37 640 2200"
											autocomplete="tel"
										></float-field>
									</div>
								</div>

								<div>
									<button type="submit" class="btn-purple">Uložiť zmeny</button>
								</div>
							</form>
						</div>
					</section>
				</tab-panel>

				<tab-panel value="1">
					<section class="bg-neutral-100 py-12 lg:py-16">
						<div class="container flex flex-col gap-10">
							<h1 class="font-serif text-2xl font-semibold leading-tight lg:text-4xl">Doručovacie adresy</h1>

							<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
								{% for address in ce.addresses %}
									<article class="flex flex-col gap-6 bg-white p-6">
										<div class="flex items-center gap-4">
											<div class="flex size-12 items-center justify-center bg-neutral-100 text-2xl text-white">
												{{ sprite('user-avatar') }}
											</div>
											<h2 class="font-serif text-lg font-semibold">{{ address.name }}</h2>
										</div>

										<address class="not-italic leading-relaxed">
											{{ address.street }}<br />
											{{ address.city }}<br />
											{{ address.country }}<br />
											{{ address.phone }}<br />
											{{ address.email }}
										</address>

										<div class="mt-auto grid grid-cols-2 gap-2">
											<button type="button" class="btn-outline-neutral px-3" @click="openAddress('edit')">
												{{ sprite('pencil') }} Upraviť
											</button>
											<button type="button" class="btn-outline-neutral px-3" @click="confirmDelete">
												{{ sprite('trash') }} Odstrániť
											</button>
										</div>
									</article>
								{% endfor %}
							</div>

							<div>
								<button type="button" class="btn-purple" @click="openAddress('add')">{{ sprite('plus') }} Pridať novú adresu</button>
							</div>
						</div>
					</section>
				</tab-panel>

				<tab-panel value="2">
					<section class="bg-neutral-100 py-12 lg:py-16">
						<div class="container flex flex-col gap-10">
							<h1 class="font-serif text-2xl font-semibold leading-tight lg:text-4xl">Objednávky</h1>

							<div class="bg-white p-4 lg:p-12">
								<div class="hidden grid-cols-[1fr_2.5fr_1fr_1fr_auto] gap-6 px-2 pb-4 font-medium lg:grid">
									<div>
										Dátum
									</div>
									<div>
										Číslo objednávky
									</div>
									<div>
										Suma
									</div>
									<div>
										Stav
									</div>
									<div>
										Faktúra
									</div>
								</div>

								<div>
									{% for order in ce.orders %}
										<details class="group {{ loop.index is odd ? 'bg-neutral-100' : '' }}" {{ order.open ? 'open' }}>
											<summary
												class="grid cursor-pointer list-none grid-cols-2 gap-3 px-2 py-3 [&::-webkit-details-marker]:hidden lg:grid-cols-[1fr_2.5fr_1fr_1fr_auto] lg:gap-6"
											>
												<div>
													<span class="text-subtile lg:hidden">Dátum:&nbsp;</span>{{ order.date }}
												</div>
												<div>
													<span class="text-subtile lg:hidden">Objednávka:&nbsp;</span>{{ order.number }}
												</div>
												<div class="font-medium text-purple">
													{{ order.total }}
												</div>
												<div>
													{{ order.status }}
												</div>
												<a href="/" class="btn-outline-neutral col-span-2 px-2 py-1 lg:col-span-1" @click.stop>
													{{ sprite('file-description') }} Faktúra {{ order.number }}
												</a>
												<div class="col-span-2 flex items-center gap-3 text-sm font-medium lg:col-span-5">
													Zobraziť položky
													{{ sprite('chevron-down', 'transit group-open:rotate-180') }}
												</div>
											</summary>

											{% if order.items %}
												<div class="flex flex-col gap-3 px-2 pb-5">
													{% for product in order.items %}
														<div class="grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-3">
															<img src="/assets/images/products/product.png" alt="" class="size-10 object-contain" />
															<span>{{ product.title }}</span>
															<span class="whitespace-nowrap">{{ product.quantity }}ks&nbsp;&nbsp; {{ product.price }}</span>
														</div>
													{% endfor %}
												</div>
											{% endif %}
										</details>
									{% endfor %}
								</div>

								<div class="flex justify-center pt-10">
									<button type="button" class="btn-outline-neutral">Načítať viac ({{ ce.moreCount }})</button>
								</div>
							</div>
						</div>
					</section>
				</tab-panel>
			</tab-panels>
		</tabs>
	</template>

	<template #address-header="{ editing }">
		<h2 v-if="editing" class="font-serif text-2xl font-semibold leading-tight">Upraviť adresu</h2>
		<h2 v-else class="font-serif text-2xl font-semibold leading-tight">Nová doručovacia adresa</h2>
	</template>

	<template #address="{ close, editing }">
		<form class="flex flex-col gap-4" @submit.prevent="close">
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<float-field
					id="address-first-name"
					label="Meno*"
					name="firstName"
					:model-value="editing ? 'Martin' : ''"
					placeholder="Martin"
					autocomplete="given-name"
					required
				></float-field>
				<float-field
					id="address-last-name"
					label="Priezvisko*"
					name="lastName"
					:model-value="editing ? 'Chynoranský' : ''"
					placeholder="Chynoranský"
					autocomplete="family-name"
					required
				></float-field>
				<float-field
					id="address-email"
					label="E-mail"
					name="email"
					field-type="email"
					:model-value="editing ? 'chynoransky@gmail.com' : ''"
					placeholder="Zadajte váš e-mail"
					autocomplete="email"
				></float-field>
				<float-field
					id="address-phone"
					label="Tel. č."
					name="phone"
					field-type="tel"
					:model-value="editing ? '+421 37 640 2200' : ''"
					placeholder="+421 900 000 000"
					autocomplete="tel"
				></float-field>
			</div>

			<float-field
				id="address-company"
				label="Názov firmy"
				name="company"
				:model-value="editing ? 'NovaTech Logistika, s.r.o.' : ''"
				placeholder="NovaTech Logistika, s.r.o."
				autocomplete="organization"
			></float-field>
			<float-field
				id="address-street"
				label="Ulica a číslo *"
				name="street"
				:model-value="editing ? 'Priemyselná 14' : ''"
				placeholder="Zadajte ulicu"
				autocomplete="street-address"
				required
			></float-field>

			<div class="grid grid-cols-[minmax(0,1fr)_7.75rem] gap-4">
				<float-field
					id="address-city"
					label="Mesto *"
					name="city"
					:model-value="editing ? 'Nitra' : ''"
					placeholder="Názov mesta"
					autocomplete="address-level2"
					required
				></float-field>
				<float-field
					id="address-zip"
					label="PSČ*"
					name="zip"
					:model-value="editing ? '949 01' : ''"
					placeholder="000 00"
					autocomplete="postal-code"
					required
				></float-field>
			</div>

			<float-field id="address-country" label="Krajina" name="country" field-type="select" model-value="SK">
				<option value="SK">
					Slovensko
				</option>
			</float-field>

			<button type="submit" class="btn-purple w-full justify-center">Uložiť</button>
			<button v-if="editing" type="button" class="btn-outline-neutral w-full justify-center" @click="close">Vrátiť späť</button>
		</form>
	</template>

	<template #delete-header>
		<h2 class="font-serif text-2xl font-semibold leading-tight">Naozaj chcete odstrániť adresu?</h2>
	</template>

	<template #delete="{ close }">
		<div class="flex flex-col gap-8">
			<p>
				Táto akcia je nevratná
			</p>
			<div class="flex flex-col gap-2.5">
				<button type="button" class="btn-red h-12 w-full justify-center" @click="close">Odstrániť adresu</button>
				<button type="button" class="btn-outline-neutral h-12 w-full justify-center" @click="close">Vrátiť späť</button>
			</div>
		</div>
	</template>
</profile-actions>
