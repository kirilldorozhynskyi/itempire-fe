<section class="overflow-hidden py-20 md:py-24 lg:py-36 {{ ce.class }}">
	<div class="container flex flex-col gap-12 md:gap-16 lg:gap-20">
		{% include '../title/_title.twig' with {
			ce: ce,
			tag_white: ce.tagWhite
		} %}

		<stepper-view class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-6" :speed="3000" :duration="{{ ce.items|length }}">
			<template #default="{ openItem, hoverItem, leaveItem, active, progross }">
				<div
					class="decor-r w-full overflow-hidden {{
					ce.variant == 'landscape'
						? 'aspect-342/373 md:aspect-16/10 lg:aspect-580/464'
						: ce.variant == 'medium' ? 'aspect-342/373 md:aspect-16/10 lg:aspect-580/520' : 'aspect-342/360 md:aspect-16/10 lg:aspect-580/632'
					}}"
				>
					{% if ce.image %}
						<div class="size-full">
							{{ image(ce.image) }}
						</div>
					{% else %}
						{% for item in ce.items %}
							<div class="size-full" v-show="active === {{ loop.index }}">
								{{ image(item.image) }}
							</div>
						{% endfor %}
					{% endif %}
				</div>
				<div class="flex flex-col justify-center lg:ps-14">
					{% for item in ce.items %}
						<button
							@click="openItem({{ loop.index }})"
							@mouseenter="hoverItem({{ loop.index }})"
							@mouseleave="leaveItem({{ loop.index }})"
							class="group relative flex cursor-pointer flex-col gap-4 border-b border-neutral-300 py-6 text-left lg:gap-2 lg:py-8"
						>
							<div class="flex items-center gap-8">
								<div
									class="flex h-8 min-w-8 items-center justify-center text-center leading-none transit group-hover:bg-neutral-100"
									:class="active === {{ loop.index }}
									? 'bg-coffee-100 text-purple'
									: 'text-subtile'"
								>
									{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}
								</div>

								<div class="font-serif text-base leading-tight font-semibold lg:text-2x">
									{{ item.title }}
								</div>
							</div>

							<div class="ps-16 md:ps-18" v-show="active === {{ loop.index }}">
								<div class="text-subtile text-balance text-start tracking-tight max-w-107">
									{{ item.text }}
								</div>
							</div>

							<div class="absolute bottom-0 left-0 h-px bg-purple" v-show="active === {{ loop.index }}" :style="`width: ${ progross }%`"></div>
						</button>
					{% endfor %}
				</div>
			</template>
		</stepper-view>
	</div>
</section>
