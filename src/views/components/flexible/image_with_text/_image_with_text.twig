{% set expertise = ce.variant == 'expertise' %}

<section class="{{ expertise ? 'container pt-20 lg:pt-36' : 'py-20 lg:py-36' }}">
	<div
		class="{{ expertise ? 'bg-remover w-full gap-8 bg-neutral-100 p-6 md:p-8 lg:gap-12' : 'container gap-12 lg:gap-16' }} grid items-center lg:grid-cols-2"
	>
		<div class="flex flex-col max-w-120 {{ expertise ? 'min-w-0 gap-4' : 'gap-6' }}">
			{% if expertise and ce.tag %}
				<span class="text-xs font-medium tracking-wide text-purple uppercase" v-jd-animate>{{ ce.tag }}</span>
			{% endif %}
			<h2
				class="text-balance font-serif leading-tight font-semibold {{ ce.titleClass|default(
					expertise ? 'text-3xl lg:text-[2rem]' : 'text-4xl lg:text-5xl'
				) }}"
				v-jd-animate
			>
				{{ ce.title|raw }}
			</h2>

			<div class="flex flex-col gap-4 text-base tracking-tight text-subtile" v-jd-animate>
				{% for paragraph in ce.paragraphs %}
					<p>
						{{ paragraph }}
					</p>
				{% endfor %}
			</div>

			{% if ce.items %}
				<ul class="flex flex-col gap-2">
					{% for item in ce.items %}
						<li class="grid grid-cols-[1.5rem_minmax(0,1fr)] items-start gap-4" v-jd-animate>
							{{ sprite('check', 'text-2xl') }}
							<span>{{ item }}</span>
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</div>

		{% if expertise %}
			<ul class="flex min-w-0 flex-col divide-y divide-neutral-300">
				{% for credential in ce.credentials %}
					<li class="grid grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-1.5 py-4 first:pt-0 last:pb-0" v-jd-animate>
						{{ sprite(credential.icon, 'text-2xl text-purple') }}
						<h3 class="min-w-0 text-pretty font-serif text-xl leading-tight font-semibold">{{ credential.title }}</h3>
						<p class="col-start-2 text-sm text-subtile">
							{{ credential.text }}
						</p>
					</li>
				{% endfor %}
			</ul>
		{% else %}
			<div class="decor-md relative aspect-342/336 w-full overflow-hidden lg:aspect-580/571" v-jd-animate>
				{{ image(ce.image) }}
			</div>
		{% endif %}
	</div>
</section>
