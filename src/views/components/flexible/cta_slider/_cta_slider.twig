<section>
	<div class="max-w-520 mx-auto">
		<slider-wrapper
			class="h-185 w-full lg:h-auto lg:aspect-1280/624"
			:dots="true"
			:nav="false"
			:fade="true"
			dots-class="absolute bottom-6 lg:bottom-12 left-1/2 -translate-x-1/2 z-10"
		>
			{% for item in ce.items %}
				<slider-item class="relative h-185 basis-full overflow-hidden bg-black lg:h-auto lg:aspect-1280/624">
					<div class="cta-slider-media absolute inset-0">
						{{ image(item.image) }}
					</div>
					<div class="absolute inset-0">
						<div class="container flex h-full items-start px-6 py-16 lg:items-center lg:px-12 lg:py-20">
							<div class="flex w-full flex-col gap-6 lg:max-w-103 lg:gap-12">
								<div class="flex flex-col gap-4 lg:gap-6">
									{% if item.title %}
										<h2 class="text-balance font-serif text-[1.375rem] lg:text-4xl leading-tight font-semibold text-white" v-jd-animate>
											{{ item.title }}
										</h2>
									{% endif %}

									{% if item.text %}
										<p class="text-balance tracking-tight text-white/70" v-jd-animate>
											{{ item.text }}
										</p>
									{% endif %}
								</div>

								<div v-jd-animate class="flex">
									{% include paths.btn_ex with {
										button: item.btn
									} only %}
								</div>
							</div>
							<div class="cta-slider-info absolute leading-none" style="{{ item.info.style }}" v-jd-animate>
								<div class="absolute top-0 right-6 w-fit -translate-y-1/2 bg-white px-4 py-2 text-sm font-medium text-purple uppercase">
									{{ item.info.tag }}
								</div>
								<div class="bg-purple p-6 text-balance font-serif text-2xl lg:text-5xl leading-tight font-semibold text-white">
									{{ item.info.price }}
								</div>
								<div
									class="absolute bottom-0 left-6 w-fit translate-y-1/2 bg-white px-4 py-2 text-sm font-medium whitespace-nowrap text-purple uppercase"
								>
									{{ item.info.info }}
								</div>
							</div>
						</div>
					</div>
				</slider-item>
			{% endfor %}
		</slider-wrapper>
	</div>
</section>
