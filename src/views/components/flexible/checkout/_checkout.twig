{#
 # File: /src/views/components/flexible/checkout/_checkout.twig
 # Project: itempire-fe
 #}

<section class="py-12 lg:py-20">
	<div class="container flex flex-col gap-8 lg:gap-12">
		{% include '../../checkout/_steps.twig' with {
			current: 2
		} only %}

		<h1 class="font-serif text-2xl font-semibold leading-tight lg:text-4xl">Adresa a fakturácia</h1>

		<div class="grid grid-cols-1 items-start gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(20rem,1fr)]">
			<div class="flex flex-col gap-6">
				<form action="/shipping/" class="flex flex-col gap-5 border border-neutral-300 p-6">
					<h2 class="font-serif text-2xl font-semibold">Prihláste sa</h2>
					<float-field
						id="checkout-login-email"
						label="E-mail"
						name="login_email"
						field-type="email"
						autocomplete="email"
						placeholder="Zadajte váš e-mail"
					></float-field>
					<float-field
						id="checkout-login-password"
						label="Heslo"
						name="login_password"
						field-type="password"
						autocomplete="current-password"
						placeholder="Zadajte heslo"
					></float-field>
					<a href="/" class="self-end text-sm text-purple underline">Zabudli ste heslo?</a>
					<button type="submit" class="btn-purple w-full justify-center">Prihlásiť sa</button>
					<p class="text-center">
						Alebo sa prihláste cez:
					</p>
					<div class="grid grid-cols-2 gap-4">
						<button type="button" class="btn-outline-neutral">{{ sprite('apple') }} Apple</button>
						<button type="button" class="btn-outline-neutral">{{ sprite('google') }} Google</button>
					</div>
				</form>

				<form action="/shipping/" class="flex flex-col gap-5 border border-neutral-300 p-6">
					<h2 class="font-serif text-2xl font-semibold">Nemáte u nás účet?</h2>
					<h3 class="font-serif text-lg font-semibold">Vaše údaje</h3>
					<float-field
						id="checkout-email"
						label="E-mail"
						name="email"
						field-type="email"
						autocomplete="email"
						placeholder="Zadajte váš e-mail"
					></float-field>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<float-field id="checkout-first-name" label="Meno*" name="first_name" autocomplete="given-name" placeholder="Vaše meno"></float-field>
						<float-field
							id="checkout-last-name"
							label="Priezvisko*"
							name="last_name"
							autocomplete="family-name"
							placeholder="Vaše priezvisko"
						></float-field>
					</div>
					<float-field
						id="checkout-phone"
						label="Tel. č."
						name="phone"
						field-type="tel"
						autocomplete="tel"
						placeholder="+421 900 000 000"
					></float-field>

					<h3 class="font-serif text-lg font-semibold">Fakturačná adresa</h3>
					<label class="form-check"><input class="form-check-input" type="checkbox" checked /><span>Som firma / živnostník</span></label>
					<label class="form-check"><input class="form-check-input" type="checkbox" /><span>Dodacia adresa je iná ako fakturačná</span></label>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<float-field
							id="checkout-company"
							label="Názov firmy *"
							name="company"
							autocomplete="organization"
							placeholder="Zadajte názov"
						></float-field>
						<float-field id="checkout-vat-id" label="IČ DPH" name="vat_id" placeholder="Zadajte IČ DPH"></float-field>
						<float-field id="checkout-company-id" label="IČO*" name="company_id" placeholder="Zadajte IČO"></float-field>
						<float-field id="checkout-tax-id" label="DIČ*" name="tax_id" placeholder="Zadajte DIČ"></float-field>
						<float-field
							id="checkout-street"
							label="Ulica a číslo *"
							name="street"
							autocomplete="street-address"
							placeholder="Zadajte ulicu"
							class="sm:col-span-2"
						></float-field>
						<float-field id="checkout-city" label="Mesto *" name="city" autocomplete="address-level2" placeholder="Názov mesta"></float-field>
						<float-field id="checkout-postal-code" label="PSČ*" name="postal_code" autocomplete="postal-code" placeholder="000 00"></float-field>
					</div>
					<float-field id="checkout-country" label="Krajina" name="country" field-type="select" model-value="SK">
						<option value="SK">
							Slovensko
						</option>
					</float-field>
					<float-field id="checkout-note" label="Poznámka k nákupu" name="note" field-type="textarea" placeholder="Vaša správa"></float-field>
					<button type="submit" class="btn-purple w-full justify-center xl:hidden">Pokračovať na dopravu a platbu</button>
				</form>
			</div>

			{% include '../../checkout/_summary.twig' with {
				title: 'Súhrn objednávky',
				showProduct: true,
				delivery: true,
				checks: true,
				total: '18 829,23 €',
				nextUrl: '/shipping/',
				button: 'Objednať s povinnosťou platby'
			} only %}
		</div>
	</div>
</section>
