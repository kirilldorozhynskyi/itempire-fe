<section class="decor bg-neutral-100 py-20 lg:py-36">
	<div class="container flex flex-col gap-12 lg:gap-20">
		<h2 class="text-balance font-serif text-4xl leading-tight font-semibold lg:text-5xl">{{ ce.title }}</h2>

		<div class="grid gap-4 md:grid-cols-3 md:gap-6">
			{% for item in ce.items %}
				<div class="bg-remover relative flex min-h-56 flex-col gap-16 bg-white p-6">
					<span class="flex size-8 items-center justify-center bg-neutral-100 text-sm">{{ '%02d'|format(loop.index) }}</span>

					<div class="mt-auto flex flex-col gap-2">
						<h3 class="text-balance font-serif text-lg leading-tight font-semibold">{{ item.title }}</h3>
						<p class="text-sm leading-normal text-subtile">
							{{ item.text }}
						</p>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
