<section class="pt-6 pb-16">
	<div class="container flex flex-col gap-12">
		<div class="flex items-center gap-1">
			{% for item in ce.crumbs %}
				<div class="flex items-center gap-1 text-sm">
					{% if item.link %}
						<a class="flex" href="{{ item.link }}" aria-label="{{ item.title }}" target="_self">
							{% if item.icon %}
								{{ sprite(item.icon, 'text-base') }}
							{% else %}
								<span class="transit not-hover:text-subtile">{{ item.title }}</span>
							{% endif %}
						</a>
					{% else %}
						<span cl>{{ item.title }}</span>
					{% endif %}

					{% if loop.last == false %}
						{{ sprite('chevron-right') }}
					{% endif %}
				</div>
			{% endfor %}
		</div>
		{% if ce.title %}
			<div class="mt-4">
				<h1 class="text-balance font-serif leading-none font-semibold text-4xl lg:text-6xl" v-jd-animate>{{ ce.title }}</h1>
			</div>
		{% endif %}

		{% if ce.category %}
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 2xl:grid-cols-5 uhd:grid-cols-6">
				{% for item in ce.category %}
					<a
						href="{{ item.url }}"
						aria-label="{{ item.title }}"
						class="flex border border-neutral-300 transit hover:bg-neutral-100"
						v-jd-animate="{ delay: {{ loop.index * 100 }} }"
					>
						<div class="size-16 aspect-square">
							{{ image(item.image) }}
						</div>
						<div class="flex items-center px-4 py-1 text-sm font-medium leading-[1.3]">
							{{ item.title }}
						</div>
					</a>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
