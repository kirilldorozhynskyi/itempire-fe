{#
 # File: /src/views/components/flexible/cart/_cart.twig
 # Project: itempire-fe
 #}

<section class="py-12 lg:py-20">
	<div class="container flex flex-col gap-12">
		{% include '../../checkout/_steps.twig' with { current: 1 } only %}

		<h1 class="font-serif text-4xl font-semibold leading-tight">Nákupný košík</h1>

		<div class="grid grid-cols-1 items-start gap-8 xl:grid-cols-[minmax(0,2fr)_minmax(20rem,1fr)]">
			<div class="border border-neutral-300 p-4 lg:p-8">
				{% for product in ce.products %}
					<article class="flex flex-col gap-5 border-b border-neutral-300 py-6 first:pt-0 last:border-0 last:pb-0">
						<div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-4 lg:grid-cols-[5rem_minmax(0,1fr)_auto_auto_auto] lg:items-center">
							<img src="/assets/images/products/product.png" alt="{{ product.title }}" class="size-20 object-contain" />
							<div>
								<h2 class="font-serif font-semibold">{{ product.title }}</h2>
								<div class="mt-2 flex items-center gap-3 text-sm"><span class="size-2 bg-success"></span>Na sklade</div>
							</div>
							<quantity-input :model-value="99"></quantity-input>
							<strong class="font-serif text-lg">{{ product.price }}</strong>
							<button type="button" aria-label="Odstrániť produkt">{{ sprite('x') }}</button>
						</div>

						<div class="flex flex-col gap-3 text-sm">
							<strong>Výnimočná starostlivosť</strong>
							<label class="form-check"><input class="form-check-input" type="checkbox" /><span>Predĺžená záruka + 1 rok</span><span class="ms-auto">183,00 €</span></label>
							<label class="form-check"><input class="form-check-input" type="checkbox" /><span>Predĺžená záruka + 2 roky</span><span class="ms-auto">183,00 €</span></label>
						</div>

						<div class="flex flex-col gap-2 text-sm">
							<strong>Dokúpte si tiež</strong>
							{% for accessory in 1..3 %}
								<div class="grid grid-cols-[2.5rem_minmax(0,1fr)_auto_auto] items-center gap-3">
									<img src="/assets/images/products/f82213b87f4721b0ada3b4323a151124e80dcf9f.png" alt="" class="size-10 object-contain" />
									<span>Hyper HyperDrive Next 11 Port USB-C Hub - Midnight Blue</span>
									<span>183,00 €</span>
									<button type="button" aria-label="Pridať príslušenstvo">{{ sprite('plus') }}</button>
								</div>
							{% endfor %}
						</div>
					</article>
				{% endfor %}
			</div>

			{% include '../../checkout/_summary.twig' with {
				title: 'Sumár košíka',
				nextUrl: '/checkout/',
				button: 'Pokračovať na adresu a platbu',
				account: true
			} only %}
		</div>
	</div>
</section>
