<section class="services overflow-hidden py-20 lg:py-36">
	<div class="container flex flex-col gap-12 lg:gap-20">
		<div class="flex flex-col items-center gap-6 mx-auto max-w-145 text-center">
			{% include '../title/_title_content.twig' with {
				ce: ce
			} %}
		</div>

		<slider-wrapper class="w-full" :overflow="false" wrapper-class="md:-me-6" :dots="true" :nav="false">
			{% for item in ce.services %}
				<slider-item class="basis-full md:basis-1/4 md:pe-6" v-jd-animate="{ delay: {{ loop.index * 100 }} }">
					<a href="{{ item.url }}" aria-label="{{ item.title }}" class="flex flex-col gap-6 lg:gap-16 p-4 lg:p-6 bg-neutral-100 relative bg-remover">
						{{ sprite(item.icon, 'text-[3.5rem]') }}

						<div class="flex flex-col gap-6 mt-auto items-start">
							<div class="flex flex-col gap-2">
								<h3 class="text-balance font-serif leading-tight font-semibold lg:text-lg">{{ item.title }}</h3>

								<p class="text-sm text-subtile leading-normal">
									{{ item.text }}
								</p>
							</div>
							{% include paths.btn_ex with {
								button: {
									span: true,
									icon: 'arrow-right',
									class: 'btn-white p-2',
									btn: {
										label: 'Otvoriť: ' ~ item.title
									}
								}
							} only %}
						</div>
					</a>
				</slider-item>
			{% endfor %}
		</slider-wrapper>

		<div v-jd-animate class="flex justify-center">
			{% include paths.btn_ex with {
				button: ce.btn
			} only %}
		</div>
	</div>
</section>
