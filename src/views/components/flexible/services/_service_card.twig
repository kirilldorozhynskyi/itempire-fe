<div class="bg-remover bg-remover h-full">
	{% if ce.variant == 'icons' %}
		<div class="flex min-h-full flex-col gap-16 bg-neutral-100 p-6">
			{{ sprite(item.icon, 'text-[3.5rem]') }}
			{% if ce.layout == 'grid' %}
				<h2 class="mt-auto text-balance font-serif text-lg leading-tight font-semibold">{{ item.title }}</h2>
			{% else %}
				<h3 class="mt-auto text-balance font-serif text-lg leading-tight font-semibold">{{ item.title }}</h3>
			{% endif %}
		</div>
	{% else %}
		<a
			href="{{ item.url }}"
			aria-label="{{ item.title }}"
			tabindex="{{ repeat > 1 ? '-1' : '0' }}"
			class="bg-remover relative flex min-h-full flex-col gap-10 bg-neutral-100 p-6 lg:gap-16"
		>
			{{ sprite(item.icon, 'text-[3.5rem]') }}

			<div class="flex flex-1 flex-col items-start justify-end gap-6">
				<div class="flex flex-col gap-2">
					{% if ce.layout == 'grid' %}
						<h2 class="text-balance font-serif text-base leading-tight font-semibold lg:text-lg">{{ item.title }}</h2>
					{% else %}
						<h3 class="text-balance font-serif text-base leading-tight font-semibold lg:text-lg">{{ item.title }}</h3>
					{% endif %}

					<p class="text-sm leading-normal text-subtile">
						{{ item.text }}
					</p>
				</div>
				{% if ce.showArrows is not same as(false) %}
					{% include paths.btn_ex with {
						button: {
							span: true,
							icon: 'arrow-right',
							class: 'btn-white p-2',
							btn: {
								label: 'Otvoriť: ' ~ item.title
							}
						}
					} only %}
				{% endif %}
			</div>
		</a>
	{% endif %}
</div>
