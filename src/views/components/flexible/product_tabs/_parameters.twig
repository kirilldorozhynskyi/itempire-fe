{#
 # File: /src/views/components/flexible/product_tabs/_parameters.twig
 # Project: itempire-fe
 #}

<div class="flex flex-col gap-8" v-jd-animate>
	{% for group in groups %}
		<div class="flex flex-col gap-4">
			{% if group.title %}
				<h2 class="font-medium leading-tight px-2">{{ group.title }}</h2>
			{% endif %}

			<table class="block md:table w-full table-fixed">
				<tbody class="block md:table-row-group">
					{% for item in group.items %}
						<tr
							class="block md:table-row px-2 py-3 md:p-0 {{
							(group.title and loop.index is odd) or (not group.title and loop.index is even)
								? 'bg-neutral-100'
								: ''
							}}"
						>
							<th class="block md:table-cell w-full md:w-1/2 md:px-2 pb-1 md:py-3 text-left text-subtile font-normal align-top">
								{{ item.label }}
							</th>

							<td class="block md:table-cell w-full md:w-1/2 md:px-2 md:py-3 align-top">{{ item.value }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% endfor %}
</div>
