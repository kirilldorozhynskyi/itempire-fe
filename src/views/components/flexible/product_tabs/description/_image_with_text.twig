{#
 # File: /src/views/components/flexible/product_tabs/description/_image_with_text.twig
 # Project: itempire-fe
 #}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center py-4">
	<div class="{{ ce.imagePosition == 'left' ? 'lg:order-1' : 'lg:order-2' }}" v-jd-animate>
		{{ image(ce.image) }}
	</div>

	<div class="{{ ce.imagePosition == 'left' ? 'lg:order-2 lg:ps-16' : 'lg:order-1' }}">
		<div class="max-w-129 uhd:max-w-180 flex flex-col gap-6">
			{% if ce.title %}
				<h3 class="text-balance font-serif leading-tight font-semibold text-xl lg:text-2xl" v-jd-animate>{{ ce.title }}</h3>
			{% endif %}

			{% if ce.text %}
				<div class="wysiwyg text-balance" v-jd-animate>
					{{ ce.text|raw }}
				</div>
			{% endif %}
		</div>
	</div>
</div>
