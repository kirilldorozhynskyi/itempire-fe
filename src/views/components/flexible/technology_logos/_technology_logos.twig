{% if ce.logos|length %}
	<section {{ ce.id ? 'id="' ~ ce.id ~ '"' }} class="flex flex-col gap-12 pb-20 lg:gap-20 lg:pb-36">
		<div class="container flex flex-col items-center gap-8 text-center">
			<h2 class="max-w-5xl font-serif text-3xl font-semibold leading-tight lg:text-5xl" v-jd-animate>{{ ce.title }}</h2>
			{% if ce.btn %}
				{% include paths.btn_ex with {
					button: ce.btn
				} %}
			{% endif %}
		</div>
		<div class="technology-logos relative grid items-center">
			<benefits :count="{{ ce.logos|length }}" direction="{{ ce.direction|default('left') }}" :pause-on-hover="true">
				{% for logo in ce.logos %}
					{% set logoSrc = logo.src|default(logo) %}
					<div class="rfm-child technology-logo flex size-16 shrink-0 items-center justify-center">
						<div class="technology-logo-tile flex size-full items-center justify-center bg-neutral-100 p-2">
							<img
								class="size-full object-contain {{ logo.monochrome ? 'logo-monochrome' }}"
								src="{{ logoSrc }}"
								alt="{{ logo.alt|default(
									logoSrc
										|split('/')
										|last
										|replace({
											'.svg': '',
											'-': ' '
										})
								) }}"
								loading="lazy"
								decoding="async"
							/>
						</div>
					</div>
				{% endfor %}
			</benefits>
			<div
				class="technology-logos-brand pointer-events-none absolute left-1/2 z-10 flex aspect-214/104 w-53.5 -translate-x-1/2 items-center justify-center"
			>
				<img class="aspect-118/104 w-29.5 object-contain" src="/assets/images/brand/emblem.svg" alt="ITempire" width="118" height="104" />
			</div>
		</div>
	</section>
{% endif %}
