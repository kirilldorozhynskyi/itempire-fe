<section class="decor overflow-hidden bg-neutral-100 py-20 md:py-24 lg:py-36">
	<div class="container flex flex-col gap-12 md:gap-16 lg:gap-20">
		<div class="flex flex-col items-center gap-6 mx-auto max-w-145 text-center">
			{% include '../title/_title_content.twig' with {
				ce: ce
			} %}
		</div>

		<tabs value="tab_0">
			<tab-list>
				{% for item in ce.items %}
					<tab value="tab_{{ loop.index0 }}">
						{{ item.title }}
					</tab>
				{% endfor %}
			</tab-list>
			<tab-panels class="pt-12! md:pt-16! lg:pt-20!">
				{% for item in ce.items %}
					<tab-panel value="tab_{{ loop.index0 }}">
						<slider-wrapper class="w-full" :overflow="false" wrapper-class="-me-2 lg:-me-6" :dots="true" :nav="true" responsive-controls>
							{% for product in item.products|default(ce.products) %}
								<slider-item
									class="basis-full pe-2 sm:basis-1/2 lg:pe-6 lg:basis-1/3 2xl:basis-1/4"
									v-jd-animate="{ delay: {{ loop.index * 100 }} }"
								>
									{% include paths.posts ~ 'products/_teaser.twig' with {
										item: product
									} only %}
								</slider-item>
							{% endfor %}
						</slider-wrapper>
					</tab-panel>
				{% endfor %}
			</tab-panels>
		</tabs>

		{% if ce.btn %}
			<div class="flex justify-center" v-jd-animate>
				{% include paths.btn_ex with {
					button: ce.btn
				} only %}
			</div>
		{% endif %}
	</div>
</section>
