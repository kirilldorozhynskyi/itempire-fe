<section class="bg-neutral-100 py-20 lg:py-36 overflow-hidden decor">
	<div class="container flex flex-col gap-12 lg:gap-20">
		<div class="flex flex-col items-center gap-6 mx-auto max-w-145 text-center">
			{% include '../title/_title_content.twig' with {
				ce: ce
			} %}
		</div>

		<tabs :value="0">
			<tab-list>
				{% for item in ce.items %}
					<tab :value="{{ loop.index0 }}">
						{{ item.title }}
					</tab>
				{% endfor %}
			</tab-list>
			<tab-panels class="pt-20!">
				{% for item in ce.items %}
					<tab-panel :value="{{ loop.index0 }}">
						<slider-wrapper class="w-full" :overflow="false" wrapper-class="md:-me-12" :dots="false" :nav="true">
							{% for product in item.products %}
								<slider-item class="basis-full md:basis-1/3 2xl:basis-1/4 md:pe-12" v-jd-animate="{ delay: {{ loop.index * 100 }} }">
									{% include paths.posts ~ 'products/_teaser.twig' with {
										item: product
									} only %}
								</slider-item>
							{% endfor %}
						</slider-wrapper>
					</tab-panel>
				{% endfor %}
			</tab-panels>
		</tabs>

		{% if ce.btn %}
			<div class="flex justify-center" v-jd-animate>
				{% include paths.btn_ex with {
					button: ce.btn
				} only %}
			</div>
		{% endif %}
	</div>
</section>
