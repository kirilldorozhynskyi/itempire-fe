{% if ce.tag %}
	<span class="tag" v-jd-animate>{{ ce.tag }}</span>
{% endif %}
{% if ce.title %}
	<h2 class="text-balance font-serif leading-tight font-semibold text-2xl lg:text-5xl" v-jd-animate>{{ ce.title }}</h2>
{% endif %}

{% if ce.text %}
	<p class="text-balance text-subtile tracking-tight" v-jd-animate>
		{{ ce.text }}
	</p>
{% endif %}
{% if ce.button %}
	<div class="" v-jd-animate>
		{% include paths.btn_ex with {
			button: ce.button
		} only %}
	</div>
{% endif %}
