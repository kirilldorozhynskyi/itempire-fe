{% if ce.tag %}
	<span class="{{ tag_white ? 'tag-white' : 'tag' }}" v-jd-animate>{{ ce.tag }}</span>
{% endif %}
{% if ce.title %}
	{% if ce.heading == 'h1' %}
		<h1 class="text-balance font-serif leading-tight font-semibold text-2xl lg:text-5xl" v-jd-animate>{{ ce.title }}</h1>
	{% else %}
		<h2 class="text-balance font-serif leading-tight font-semibold text-2xl lg:text-5xl" v-jd-animate>{{ ce.title }}</h2>
	{% endif %}
{% endif %}

{% if ce.text %}
	<p class="text-balance text-base tracking-tight text-subtile" v-jd-animate>
		{{ ce.text }}
	</p>
{% endif %}
{% if ce.button %}
	<div class="" v-jd-animate>
		{% include paths.btn_ex with {
			button: ce.button
		} only %}
	</div>
{% endif %}
