<section class="overflow-hidden py-6 md:py-12 lg:py-21.5">
	<div class="container">
		<div class="grid items-center gap-12 md:gap-16 lg:grid-cols-2 lg:gap-15">
			<div class="flex flex-col gap-6">
				{% if ce.title %}
					<h1 class="text-balance font-serif leading-none font-semibold text-4xl lg:text-6xl" v-jd-animate>{{ ce.title|raw }}</h1>
				{% endif %}

				{% if ce.text %}
					<p class="max-w-116 text-pretty text-base tracking-tight text-subtile" v-jd-animate>
						{{ ce.text }}
					</p>
				{% endif %}

				<div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap" v-jd-animate>
					{% for button in ce.buttons %}
						<div class="[&>*]:w-full sm:[&>*]:w-auto">
							{% include paths.btn_ex with {
								button: button
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>

			{% if ce.image %}
				<div class="relative mx-auto w-full max-w-140 lg:max-w-none">
					<div class="absolute inset-0 aspect-square bg-neutral-100 w-7/10 left-2/5 top-3/20 translate-y-1/2"></div>

					{{ image(ce.image, {
						lazy: false,
						loading: 'eager',
						decoding: 'async',
						fetchpriority: 'high'
					}) }}

					{% if ce.tags %}
						<div class="absolute inset-0 flex flex-col items-start justify-end gap-2 p-4 md:p-8 lg:block lg:p-0">
							{% for tag in ce.tags %}
								<div
									v-jd-animate="{ delay: {{ loop.index0 * 1 }} }"
									class="flex items-center leading-none lg:absolute {{ tag.position == 'left' ? 'lg:flex-row-reverse' : '' }}"
									style="{{ tag.position }}:{{ tag.left }}; top:{{ tag.top }};"
								>
									<div class="bg-white rounded-sm p-1 flex items-center">
										<div class="flex items-center rounded-xs bg-purple text-2x text-white">
											{{ sprite('check', 'check') }}
										</div>
									</div>

									<svg class="-mx-px" width="9" height="18" viewBox="0 0 9 18" fill="none" xmlns="http://www.w3.org/2000/svg">
										<rect y="3" width="9" height="12" fill="white" />
										<path d="M0 3H3C1.48612 2.69722 0.302776 1.51388 0 0V3Z" fill="white" />
										<path d="M9 3H6C7.51388 2.69722 8.69722 1.51388 9 0V3Z" fill="white" />
										<path d="M0 15H3C1.48612 15.3028 0.302776 16.4861 0 18V15Z" fill="white" />
										<path d="M9 15H6C7.51388 15.3028 8.69722 16.4861 9 18V15Z" fill="white" />
									</svg>

									<div class="rounded-sm bg-white p-2 text-sm font-medium tracking-tight whitespace-nowrap text-purple">
										{{ tag.title }}
									</div>
								</div>
							{% endfor %}
						</div>
					{% endif %}
				</div>
			{% endif %}
		</div>
	</div>
</section>
