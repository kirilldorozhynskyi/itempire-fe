<section class="flex flex-col gap-6 pt-12 md:pt-16 lg:pt-20">
	{% if ce.text %}
		<div class="container">
			<p class="text-pretty text-center text-sm leading-none text-subtile" v-jd-animate>
				{{ ce.text }}
			</p>
		</div>
	{% endif %}
	<div class="logos-wrapper relative flex w-full items-center overflow-hidden h-auto">
		<benefits :count="{{ ce.logos|length }}">
			{% for logo in ce.logos %}
				<div class="rfm-child w-43 flex items-center aspect-172/112">
					<object class="size-full object-contain object-center" lazy type="image/svg+xml" data-src="{{ logo }}"></object>
				</div>
			{% endfor %}
		</benefits>
	</div>
</section>
