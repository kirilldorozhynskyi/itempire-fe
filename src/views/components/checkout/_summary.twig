{#
 # File: /src/views/components/checkout/_summary.twig
 # Project: itempire-fe
 #}

<aside class="flex flex-col gap-8">
	<div class="decor-sm bg-neutral-100 p-6 pt-12">
		<h2 class="mb-6 font-serif text-2xl font-semibold leading-tight">{{ title|default('Sumár košíka') }}</h2>

		{% if showProduct %}
			<div class="mb-6 grid grid-cols-[2.5rem_1fr_auto] items-center gap-3 border-b border-neutral-300 pb-6">
				<img src="/assets/images/products/product.png" alt="" class="size-10 object-contain" />
				<span class="text-sm">ACER Aspire 14 AI A14-53M-56LA OLED Pure Silver</span>
				<span class="text-end text-sm">3ks<br /><strong>3 799,00 €</strong></span>
			</div>
		{% endif %}

		<dl class="flex flex-col gap-3">
			<div class="flex justify-between gap-4"><dt>Produkty bez DPH</dt><dd class="font-semibold">14 829,23 €</dd></div>
			<div class="flex justify-between gap-4"><dt>DPH (23%)</dt><dd class="font-semibold">4 829,23 €</dd></div>
			{% if delivery %}
				<div class="mt-3 flex justify-between gap-4 border-t border-neutral-300 pt-4"><dt>DPD: doručenie na adresu</dt><dd class="font-semibold">Zadarmo</dd></div>
				<div class="flex justify-between gap-4"><dt>Platba kartou online</dt><dd class="font-semibold">Zadarmo</dd></div>
			{% endif %}
			<div class="mt-3 flex items-center justify-between gap-4 border-t border-neutral-300 pt-4">
				<dt>Spolu s DPH</dt>
				<dd class="font-serif text-2xl font-semibold">{{ total|default('318 829,23 €') }}</dd>
			</div>
		</dl>

		{% if checks %}
			<div class="mt-6 flex flex-col gap-3 text-sm text-subtile">
				<label class="form-check"><input class="form-check-input" type="checkbox" required /><span>Potvrdzujem, že som sa oboznámil s obchodnými podmienkami.</span></label>
				<label class="form-check"><input class="form-check-input" type="checkbox" /><span>Súhlasím so spracovaním osobných údajov.</span></label>
			</div>
		{% endif %}

		<a href="{{ nextUrl }}" class="btn-purple mt-6 w-full justify-center">{{ button }}</a>
	</div>

	{% if account %}
		<div class="text-center">
			<h2 class="font-serif text-2xl font-semibold">Máte účet?</h2>
			<p class="mb-6">Prihláste sa pre jednoduchší proces</p>
			<a href="/profile/" class="btn-outline-neutral w-full justify-center">Prihlásenie</a>
		</div>
	{% endif %}
</aside>
