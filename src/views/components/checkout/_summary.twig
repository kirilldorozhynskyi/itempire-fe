{#
 # File: /src/views/components/checkout/_summary.twig
 # Project: itempire-fe
 #}

<aside class="flex flex-col gap-8 sticky top-22">
	<div class="decor-sm flex flex-col gap-6 bg-neutral-100 p-6 pt-12">
		<h2 class="font-serif text-2xl font-semibold leading-tight">{{ title|default('Sumár košíka') }}</h2>

		{% if showProduct %}
			<div class="grid grid-cols-[2.5rem_1fr_auto] items-center gap-3 border-b border-neutral-300 pb-6">
				<img src="/assets/images/products/product.png" alt="" class="size-10 object-contain" />
				<span class="text-sm">ACER Aspire 14 AI A14-53M-56LA OLED Pure Silver</span>
				<div class="text-end text-sm flex flex-col gap-1">
					<span class="text-subtile">3ks</span>
					<span class="font-semibold">3 799,00 €</span>
				</div>
			</div>
		{% endif %}

		<dl class="flex flex-col gap-3">
			<div class="flex justify-between gap-4">
				<dt>
					Produkty bez DPH
				</dt><dd class="font-semibold">14 829,23 €</dd>
			</div>
			<div class="flex justify-between gap-4">
				<dt>
					DPH (23%)
				</dt><dd class="font-semibold">4 829,23 €</dd>
			</div>
			{% if delivery %}
				<div class="flex justify-between gap-4 border-t border-neutral-300 pt-4">
					<dt>
						DPD: doručenie na adresu
					</dt><dd class="font-semibold">Zadarmo</dd>
				</div>
				<div class="flex justify-between gap-4">
					<dt>
						Platba kartou online
					</dt><dd class="font-semibold">Zadarmo</dd>
				</div>
			{% endif %}
			<div class="flex items-center justify-between gap-4 border-t border-neutral-300 pt-4">
				<dt>
					Spolu s DPH
				</dt>
				<dd class="font-serif text-2xl font-semibold">{{ total|default('318 829,23 €') }}</dd>
			</div>
		</dl>

		{% if checks %}
			<div class="flex flex-col gap-3 text-sm leading-normal text-subtile">
				<label class="form-check items-start">
					<input class="form-check-input" type="checkbox" required />
					<span>
						Potvrdzujem, že som sa oboznámil s
						<a href="/obchodne-podmienky/" class="text-purple underline">obchodnými podmienkami</a> a
						<a href="/gdpr/" class="text-purple underline">zásadami ochrany osobných údajov</a>. *
					</span>
				</label>
				<label class="form-check items-start">
					<input class="form-check-input" type="checkbox" />
					<span>Súhlasím so spracovaním <a href="/gdpr/" class="text-purple underline">osobných údajov</a> na marketingové účely.</span>
				</label>
			</div>
		{% endif %}

		<a href="{{ nextUrl }}" class="btn-purple w-full justify-center">{{ button }}</a>
	</div>

	{% if account %}
		<div class="flex flex-col gap-6 text-center">
			<h2 class="font-serif text-2xl font-semibold">Máte účet?</h2>
			<p>
				Prihláste sa pre jednoduchší proces
			</p>
			<a href="/profile/" class="btn-outline-neutral w-full justify-center">Prihlásenie</a>
		</div>
	{% endif %}
</aside>
