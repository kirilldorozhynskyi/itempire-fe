{#
 # File: /src/views/components/checkout/_steps.twig
 # Project: itempire-fe
 #}

{% set steps = [
	{
		title: 'Košík',
		url: '/cart/'
	},
	{
		title: 'Adresa a fakturácia',
		url: '/checkout/'
	},
	{
		title: 'Doprava a platba',
		url: '/shipping/'
	}
] %}

<nav aria-label="Priebeh objednávky" class="overflow-x-auto">
	<ol class="grid grid-cols-3 gap-3 sm:gap-8">
		{% for item in steps %}
			<li class="{{ loop.index == current ? 'border-purple text-purple' : 'border-transparent' }} border-b pb-4">
				<a
					href="{{ item.url }}"
					class="transit flex items-center gap-3 text-sm font-medium hover:text-purple focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple sm:gap-4 sm:text-base"
				>
					<span class="{{ loop.index <= current ? 'bg-purple text-white' : 'bg-neutral-100' }} flex size-10 shrink-0 items-center justify-center">
						{% if loop.index < current %}
							{{ sprite('check') }}
						{% else %}
							{{ loop.index }}
						{% endif %}
					</span>
					<span class="{{ loop.index == current ? '' : 'max-sm:hidden' }} min-w-0 leading-tight">{{ item.title }}</span>
				</a>
			</li>
		{% endfor %}
	</ol>
</nav>
