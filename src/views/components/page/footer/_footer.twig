<footer class="bg-purple text-white/70">
	<div>
		<div class="aspect-390/336 md:aspect-1280/624">
			{{ image(footer.image) }}
		</div>

		<div class="decor bg-purple -mt-8 lg:-mt-14 pt-8 lg:pt-14">
			<div class="py-20 lg:py-36 flex items-center flex-col gap-8 text-center">
				<div class="flex items-center flex-col gap-8 max-w-137">
					<h2 class="text-balance font-serif font-semibold text-2xl lg:text-5xl text-white leading-tight" v-jd-animate>{{ footer.title }}</h2>
					<p class="text-pretty" v-jd-animate>
						{{ footer.text }}
					</p>
				</div>

				<div class="flex justify-center" v-jd-animate>
					{% include paths.btn_ex with {
						button: footer.button
					} only %}
				</div>
			</div>
		</div>
	</div>

	<div class="footer pb-16 mt-auto">
		<div class="container flex flex-col gap-20">
			<div class="grid gap-6 lg:grid-cols-7 lg:items-start">
				<div class="lg:col-span-3 flex flex-col gap-12">
					<a class="inline-flex" href="/" aria-label="{{ site_title }}">
						{% if logoRaw %}
							{{ source(rootDir ~ '/public/assets/images/brand/logo_white.svg')|raw }}
						{% else %}
							{{ svg(logo) }}
						{% endif %}
					</a>

					<div class="flex flex-col gap-4 max-w-92 tracking-tight">
						<p>
							ITempire je mladá, moderná a dynamicky sa rozvíjajúca slovenská spoločnosť, ktorá sa venuje IT službám.
						</p>
						<p>
							Našou hlavou prioritou je vždy navrhnúť najvhodnejšie riešenie pre zákazníka.
						</p>
					</div>

					{% if social %}
						<div class="flex gap-2">
							{% for item in social %}
								<a class="btn-social" href="{{ item.url }}" aria-label="{{ item.title }}" target="_blank" rel="noopener noreferrer">
									{{ sprite(item.icon) }}
								</a>
							{% endfor %}
						</div>
					{% endif %}
				</div>

				<div class="[20rem]:grid-cols-2 lg:col-span-4 grid lg:grid-cols-3 gap-6">
					{% include '_navigation.twig' with {
						menu: footer_1
					} %}
					{% include '_navigation.twig' with {
						menu: footer_2
					} %}

					<div class="flex flex-col gap-6 items-start">
						<span class="text-white font-serif text-lg leading-tight">Kontakt</span>

						<div class="flex flex-col gap-1.25">
							<div class="flex items-center gap-4">
								{{ sprite('map-pin', 'text-2xl text-white') }}
								<div class="text-sm">
									<span>ITempire s.r.o.</span>
								</div>
							</div>

							<address class="ms-10 text-sm not-italic">
								Štefánikova trieda 81,<br />949 01 Nitra
							</address>
						</div>

						<a href="tel:+421 905 41 41 41" aria-label="+421 905 41 41 41" class="flex items-center gap-4 group">
							{{ sprite('phone', 'text-2xl text-white') }}
							<div class="text-sm">
								<span class="group-hover:after:w-full! group-hover:after:left-0! link-hover-underlined">+421 905 41 41 41</span>
							</div>
						</a>

						<a href="mailto:info@itempire.sk" aria-label="info@itempire.sk" class="flex items-center gap-4">
							{{ sprite('mail', 'text-2xl text-white') }}
							<div class="text-sm">
								<span class="group-hover:after:w-full! group-hover:after:left-0! link-hover-underlined">info@itempire.sk</span>
							</div>
						</a>
					</div>
				</div>
			</div>

			<div class="grid lg:grid-cols-3 gap-4 items-center text-sm">
				{% if footer.copyright %}
					<div class="">
						{{ '© ' ~ ('now'|date('Y')) ~ ' ' ~ footer.copyright }}
					</div>
				{% endif %}

				<div class="flex flex-wrap gap-x-4 gap-y-2 lg:justify-center lg:text-center">
					<a href="/gdpr" class="link-hover-underlined">Ochrana súkromia a cookies</a>
					<button
						type="button"
						class="link-hover-underlined cursor-pointer bg-transparent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
						data-cc="c-settings"
					>
						Nastavenia cookies
					</button>
				</div>

				<div class="flex flex-wrap lg:justify-end lg:text-end">
					<div>
						Designed by Juraj Porubän. Developed by&nbsp;<a href="https://justdev.org" target="_blank">justDev</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</footer>
