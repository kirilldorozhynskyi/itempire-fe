<div class="flex flex-col gap-6">
	{% if menu %}
		<span class="text-white font-serif text-lg leading-tight">{{ menu.title }}</span>

		<ul class="flex flex-col gap-2 text-sm">
			{% for item in menu.items %}
				<li><a class="link-hover-underlined" href="{{ item.url }}" title="{{ item.title }}">{{ item.title }}</a></li>
			{% endfor %}
		</ul>
	{% endif %}
</div>
