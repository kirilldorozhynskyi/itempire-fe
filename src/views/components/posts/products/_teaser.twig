<article class="bg-white hover:-translate-y-2 hover:shadow-2xl transit" {{ animation ? 'v-jd-animate' : '' }}>
	<a href="{{ item.url }}" aria-label="{{ item.title }}">
		<div class="aspect-368/304 relative">
			<svg class="absolute top-0 left-0 w-13/20 h-auto" width="237" height="190" viewBox="0 0 237 190" fill="none" xmlns="http://www.w3.org/2000/svg">
				<g opacity="0.6">
					<path d="M189.607 94.9465V142.434H47.4189V189.922H0V47.4253H47.4189V94.9465H189.607Z" fill="#F2F2F2" />
					<path d="M237 -0.078125H47.4174V47.4203H237V-0.078125Z" fill="#F2F2F2" />
				</g>
			</svg>

			{{ image(item.image) }}

			<div class="absolute top-0 right-0 flex gap-1">
				<div class="bg-coffee-300 py-1 px-2 tracking-tight uppercase font-medium text-sm">
					{{ item.tag }}
				</div>
			</div>
		</div>

		<div class="p-8 flex flex-col gap-6">
			<h4 class="text-balance text-sm leading-[1.3] font-medium text-subtile lg:text-base">{{ item.title }}</h4>

			<div class="flex gap-4">
				<div class="flex gap-6 flex-col flex-1">
					<span class="text-balance font-serif text-lg leading-tight font-semibold lg:text-2x">{{ item.price }}</span>

					<div class="flex items-center gap-4 text-sm font-medium leading-[1.3]">
						<div class="size-2 bg-success"></div>

						<span>Na sklade</span>
					</div>
				</div>
				<div class="flex items-end justify-end">
					{% include '../../utils/_button.twig' with {
						button: {
							span: true,
							icon: 'shopping-bag',
							class: 'btn-purple p-2 [&_svg]:text-2xl!',
							btn: {
								label: 'Pridať do košíku: ' ~ item.title
							}
						}
					} only %}
				</div>
			</div>
		</div>
	</a>
</article>
