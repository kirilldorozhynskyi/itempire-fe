{% if button.span %}
	<button type="button" class="{{ button.class }}" aria-label="{{ button.btn.title }}">
		{{ button.btn.title }}
		{% if button.icon %}
			{{ sprite(button.icon) }}
		{% endif %}
	</button>
{% else %}
	<a
		href="{{ button.btn.url }}"
		aria-label="{{ button.btn.title }}"
		{{ button.btn.target ? 'target="' ~ button.btn.target ~ '" rel="noopener noreferrer"' }}
		class="{{ button.class }}"
	>
		{{ button.btn.title }}
		{% if button.icon %}
			{{ sprite(button.icon) }}
		{% endif %}
	</a>
{% endif %}
